NODE_ENV=development
APP_PORT=3000
API_PREFIX=api/v1
APP_TIMEZONE=America/Managua
LOG_LEVEL=info

# Docker Compose local defaults. Never reuse these values outside development.
POSTGRES_DB=vehicular_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_only
APP_MIGRATOR_PASSWORD=migrator_dev_only
APP_RUNTIME_PASSWORD=runtime_dev_only
DATABASE_URL=postgresql://app_runtime:runtime_dev_only@localhost:5432/vehicular_dev?schema=public
DATABASE_MIGRATION_URL=postgresql://app_migrator:migrator_dev_only@localhost:5432/vehicular_dev?schema=public
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_SSL_MODE=disable
REDIS_URL=redis://:redis_dev_only@localhost:6379/0
REDIS_TLS_REQUIRED=false
REDIS_PASSWORD=redis_dev_only

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AWS_REGION=us-east-1
AWS_S3_PRIVATE_BUCKET=vehicular-dev-private
AWS_S3_PRESIGN_UPLOAD_TTL_SECONDS=300
AWS_S3_PRESIGN_DOWNLOAD_TTL_SECONDS=600
S3_CLEANUP_MODE=mock
ENCRYPTION_MODE=local
LOCAL_DATA_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
LOCAL_BLIND_INDEX_KEY_BASE64=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=

OTP_MODE=mock
OTP_MOCK_CODE=123456
OTP_CODE_TTL_SECONDS=300
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_FAILED_ATTEMPTS=5
OTP_LOCK_MINUTES=15
CONSENT_POLICY_VERSION=privacy-local-v1
ASSISTANCE_NOTIFICATION_MODE=mock
FCM_MODE=mock

# Generate unique values with a password manager for every environment.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
MAX_VEHICLES_PER_USER=10
VEHICLE_PHOTO_MAX_BYTES=5242880
DOCUMENT_EXPIRING_SOON_DAYS=30

# Optional. Error events are sent only when configured; no PII or request bodies are collected.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.05
