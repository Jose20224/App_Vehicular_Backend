{
  "name": "vehicular-assistance-api",
  "version": "0.1.0",
  "private": true,
  "description": "API de gestión vehicular y asistencia en carretera para Nicaragua",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --coverage",
    "test:e2e": "jest --runInBand --testPathPatterns=e2e",
    "test:migrations": "node scripts/test-migrations.cjs",
    "test:load": "k6 run test/performance/b12-backend.k6.js",
    "openapi:types": "node scripts/generate-openapi-types.cjs",
    "db:backup": "bash scripts/backup-postgres.sh",
    "db:restore-drill": "bash scripts/restore-drill.sh",
    "prisma:generate": "prisma generate",
    "db:migrate": "node scripts/require-migration-url.cjs && prisma migrate deploy",
    "db:status": "node scripts/require-migration-url.cjs && prisma migrate status",
    "db:seed": "node scripts/require-migration-url.cjs && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.900.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@sentry/nestjs": "^11.13.0",
    "bullmq": "^5.58.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "firebase-admin": "^13.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "openapi-fetch": "^0.17.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "prisma": "^7.0.0",
    "supertest": "^7.1.4",
    "testcontainers": "^11.5.1",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
