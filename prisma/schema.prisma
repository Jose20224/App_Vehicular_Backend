generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  workshop_owner
  provider_owner
  admin

  @@map("user_role")
}

enum UserStatus {
  pending_verification
  active
  suspended
  deletion_pending
  deleted

  @@map("user_status")
}

enum WorkshopStatus {
  draft
  pending_verification
  active
  suspended

  @@map("workshop_status")
}

enum WorkshopPhotoStatus {
  pending
  published
  rejected
  hidden

  @@map("workshop_photo_status")
}

enum ServiceOfferingStatus {
  draft
  published
  suspended

  @@map("service_offering_status")
}

enum WorkshopContactEventType {
  call
  whatsapp
  route_click

  @@map("workshop_contact_event_type")
}

enum ReviewStatus {
  pending
  published
  rejected
  removed

  @@map("review_status")
}

enum ReviewReportStatus {
  open
  resolved
  dismissed

  @@map("review_report_status")
}

model User {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneCiphertext       Bytes?       @map("phone_ciphertext") @db.ByteA
  phoneNonce            Bytes?       @map("phone_nonce") @db.ByteA
  phoneTag              Bytes?       @map("phone_tag") @db.ByteA
  phoneEncryptedDek     Bytes?       @map("phone_encrypted_dek") @db.ByteA
  phoneKeyVersion       String?      @map("phone_key_version") @db.VarChar(100)
  phoneHmac             Bytes?       @unique(map: "ux_users_phone_hmac") @map("phone_hmac") @db.ByteA
  phoneHmacKeyVersion   String?      @map("phone_hmac_key_version") @db.VarChar(100)
  displayName           String       @map("display_name") @db.VarChar(120)
  emailCiphertext       Bytes?       @map("email_ciphertext") @db.ByteA
  emailNonce            Bytes?       @map("email_nonce") @db.ByteA
  emailTag              Bytes?       @map("email_tag") @db.ByteA
  emailEncryptedDek     Bytes?       @map("email_encrypted_dek") @db.ByteA
  emailKeyVersion       String?      @map("email_key_version") @db.VarChar(100)
  emailHmac             Bytes?       @unique(map: "ux_users_email_hmac") @map("email_hmac") @db.ByteA
  emailHmacKeyVersion   String?      @map("email_hmac_key_version") @db.VarChar(100)
  role                  UserRole     @default(user)
  status                UserStatus   @default(active)
  phoneVerifiedAt       DateTime?    @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt           DateTime?    @map("last_login_at") @db.Timestamptz(6)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?    @map("deleted_at") @db.Timestamptz(6)
  syncVersion           BigInt       @default(0) @map("sync_version")

  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]
  consentLogs   ConsentLog[]
  syncDevices   SyncDevice[]
  vehicles      Vehicle[]
  vehicleDocuments VehicleDocument[]
  insurancePolicies InsurancePolicy[]
  reminders Reminder[]
  notificationPreferences NotificationPreference[]
  notificationLogs NotificationLog[]
  emergencyContacts EmergencyContact[]
  verifiedEmergencyNumbers EmergencyNumber[] @relation("EmergencyNumberVerifiedBy")
  assistanceRequests AssistanceRequest[]
  assistanceRequestEvents AssistanceRequestEvent[] @relation("AssistanceRequestEventActor")
  processedMutations ProcessedMutation[]
  syncBootstraps SyncBootstrap[]
  syncChannelStates SyncChannelState[]
  workshops Workshop[]
  reviews Review[] @relation("ReviewAuthor")
  moderatedReviews Review[] @relation("ReviewModerator")
  reviewReports ReviewReport[] @relation("ReviewReporter")
  reviewedReviewReports ReviewReport[] @relation("ReviewReportModerator")
  assistanceProviders AssistanceProvider[]
  workshopSpecialties WorkshopSpecialty[]
  workshopPhotos WorkshopPhoto[]
  serviceOfferings ServiceOffering[]

  @@index([role, status], map: "idx_users_role_status")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

model RefreshToken {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  tokenHash      Bytes        @unique(map: "uq_refresh_tokens_token_hash") @map("token_hash") @db.ByteA
  familyId       String       @map("family_id") @db.Uuid
  deviceId       String       @map("device_id") @db.Uuid
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(6)
  replacedById   String?      @map("replaced_by_id") @db.Uuid
  lastUsedAt     DateTime?    @map("last_used_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  userAgentHash  Bytes?       @map("user_agent_hash") @db.ByteA
  ipHash         Bytes?       @map("ip_hash") @db.ByteA

  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  device     SyncDevice    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  replacedBy RefreshToken? @relation("RefreshTokenReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces   RefreshToken[] @relation("RefreshTokenReplacement")

  @@index([userId, expiresAt], map: "idx_refresh_tokens_user_expiry")
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@index([replacedById], map: "idx_refresh_tokens_replaced_by")
  @@index([userId, deviceId], map: "idx_refresh_tokens_user_device")
  @@map("refresh_tokens")
}

model SyncDevice {
  id            String       @id @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  platform      String       @db.VarChar(16)
  deviceLabel   String?      @map("device_label") @db.VarChar(100)
  clientVersion String?      @map("client_version") @db.VarChar(40)
  lastSeenAt    DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  lastCursor    BigInt?      @map("last_cursor")
  revokedAt     DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  deviceTokens  DeviceToken[]
  refreshTokens RefreshToken[]
  syncChannelStates SyncChannelState[]
  workshops Workshop[]
  assistanceProviders AssistanceProvider[]
  workshopSpecialties WorkshopSpecialty[]
  workshopPhotos WorkshopPhoto[]
  serviceOfferings ServiceOffering[]
  syncBootstraps SyncBootstrap[]
  processedMutations ProcessedMutation[]

  @@unique([userId, id], map: "sync_devices_id_user_unique")
  @@index([userId, lastSeenAt(sort: Desc)], map: "idx_sync_devices_user_seen")
  @@index([revokedAt], map: "idx_sync_devices_revoked")
  @@map("sync_devices")
}

model DeviceToken {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String       @map("user_id") @db.Uuid
  syncDeviceId        String?      @map("sync_device_id") @db.Uuid
  platform            String       @db.VarChar(16)
  tokenCiphertext     Bytes?       @map("token_ciphertext") @db.ByteA
  tokenNonce          Bytes?       @map("token_nonce") @db.ByteA
  tokenTag            Bytes?       @map("token_tag") @db.ByteA
  tokenEncryptedDek   Bytes?       @map("token_encrypted_dek") @db.ByteA
  tokenKeyVersion     String?      @map("token_key_version") @db.VarChar(100)
  tokenAadVersion     Int?         @default(1) @map("token_aad_version")
  tokenHash           Bytes?       @unique(map: "ux_device_tokens_token_hash") @map("token_hash") @db.ByteA
  tokenHmacKeyVersion String?      @map("token_hmac_key_version") @db.VarChar(100)
  status              String       @default("active") @db.VarChar(16)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  lastSeenAt          DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  revokedAt           DateTime?    @map("revoked_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  syncDevice SyncDevice? @relation(fields: [syncDeviceId], references: [id], onDelete: Restrict)
  notificationLogs NotificationLog[]

  @@unique([id, userId], map: "ux_device_tokens_id_user")
  @@index([userId, status], map: "idx_device_tokens_user_status")
  @@index([syncDeviceId], map: "idx_device_tokens_sync_device")
  @@map("device_tokens")
}

model ConsentLog {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  consentType      String    @map("consent_type") @db.VarChar(40)
  policyVersion    String    @map("policy_version") @db.VarChar(40)
  accepted         Boolean
  clientCapturedAt DateTime? @map("client_captured_at") @db.Timestamptz(6)
  receivedAt       DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  source           String    @default("mobile") @db.VarChar(24)
  appVersion       String?   @map("app_version") @db.VarChar(40)
  ipCiphertext       Bytes?  @map("ip_ciphertext") @db.ByteA
  ipNonce            Bytes?  @map("ip_nonce") @db.ByteA
  ipTag              Bytes?  @map("ip_tag") @db.ByteA
  ipEncryptedDek     Bytes?  @map("ip_encrypted_dek") @db.ByteA
  ipKeyVersion       String? @map("ip_key_version") @db.VarChar(100)
  userAgentCiphertext Bytes?  @map("user_agent_ciphertext") @db.ByteA
  userAgentNonce      Bytes?  @map("user_agent_nonce") @db.ByteA
  userAgentTag        Bytes?  @map("user_agent_tag") @db.ByteA
  userAgentEncryptedDek Bytes? @map("user_agent_encrypted_dek") @db.ByteA
  userAgentKeyVersion String? @map("user_agent_key_version") @db.VarChar(100)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, receivedAt(sort: Desc)], map: "idx_consent_logs_user_received")
  @@index([userId, consentType, receivedAt(sort: Desc)], map: "idx_consent_logs_user_type_received")
  @@index([policyVersion, consentType], map: "idx_consent_logs_policy_type")
  @@map("consent_logs")
}


enum VehicleType {
  motorcycle
  automobile
  pickup
  truck
  bus
  other

  @@map("vehicle_type")
}

enum VehiclePhotoStatus {
  none
  pending_upload
  available

  @@map("vehicle_photo_status")
}

model VehicleBrand {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String         @db.VarChar(80)
  normalizedName String         @unique(map: "ux_vehicle_brands_normalized_name") @map("normalized_name") @db.VarChar(80)
  isActive       Boolean        @default(true) @map("is_active")
  sortOrder      Int            @default(0) @map("sort_order")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  models         VehicleModel[]
  vehicles       Vehicle[]

  @@index([isActive, sortOrder, normalizedName], map: "idx_vehicle_brands_active_order")
  @@map("vehicle_brands")
}

model VehicleModel {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId         String         @map("brand_id") @db.Uuid
  name            String         @db.VarChar(100)
  normalizedName  String         @map("normalized_name") @db.VarChar(100)
  vehicleCategory String?        @map("vehicle_category") @db.VarChar(30)
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  brand           VehicleBrand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  vehicles        Vehicle[]

  @@unique([brandId, normalizedName], map: "ux_vehicle_models_brand_normalized_name")
  @@unique([id, brandId], map: "vehicle_models_id_brand_unique")
  @@index([brandId, isActive, normalizedName], map: "idx_vehicle_models_brand_active")
  @@map("vehicle_models")
}

model CatalogVersion {
  catalogName String   @id @map("catalog_name") @db.VarChar(80)
  version     BigInt   @default(0)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("catalog_versions")
}

model Department {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String             @unique @db.VarChar(20)
  name             String             @db.VarChar(100)
  administrativeType String            @map("administrative_type") @db.VarChar(24)
  isActive         Boolean            @default(true) @map("is_active")
  sortOrder        Int                @default(0) @map("sort_order")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  municipalities  Municipality[]
  emergencyNumbers EmergencyNumber[]
  workshops Workshop[]
  assistanceProviders AssistanceProvider[]

  @@index([isActive, sortOrder, name], map: "idx_departments_active_order")
  @@map("departments")
}

model Municipality {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId      String             @map("department_id") @db.Uuid
  code              String             @unique @db.VarChar(40)
  name              String             @db.VarChar(100)
  isActive          Boolean            @default(true) @map("is_active")
  sortOrder         Int                @default(0) @map("sort_order")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  department        Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  emergencyNumbers  EmergencyNumber[]
  assistanceRequests AssistanceRequest[]
  workshops Workshop[]
  assistanceProviders AssistanceProvider[]

  @@unique([id, departmentId], map: "uq_municipalities_id_department")
  @@index([departmentId, isActive, sortOrder, name], map: "idx_municipalities_department_order")
  @@map("municipalities")
}

model ServiceType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(300)
  isEmergency Boolean  @default(false) @map("is_emergency")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  assistanceRequests AssistanceRequest[]
  serviceOfferings ServiceOffering[]
  assistanceProviders AssistanceProvider[]

  @@index([isActive, sortOrder, name], map: "idx_service_types_active_order")
  @@map("service_types")
}

model Specialty {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(300)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  workshopSpecialties WorkshopSpecialty[]

  @@index([isActive, sortOrder, name], map: "idx_specialties_active_order")
  @@map("specialties")
}

model EmergencyNumber {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label            String        @db.VarChar(120)
  category         String        @db.VarChar(40)
  phoneNumber      String        @map("phone_number") @db.VarChar(20)
  departmentId     String?       @map("department_id") @db.Uuid
  municipalityId   String?       @map("municipality_id") @db.Uuid
  sourceName       String?       @map("source_name") @db.VarChar(180)
  sourceUrl        String?       @map("source_url") @db.VarChar(500)
  verified         Boolean       @default(false)
  verifiedAt       DateTime?     @map("verified_at") @db.Timestamptz(6)
  verifiedByUserId String?       @map("verified_by_user_id") @db.Uuid
  notes            String?       @db.VarChar(500)
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  department       Department?   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  verifiedByUser   User?         @relation("EmergencyNumberVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  municipality     Municipality? @relation(fields: [municipalityId], references: [id], onDelete: Restrict)

  @@index([isActive, verified, category], map: "idx_emergency_numbers_public")
  @@index([departmentId, municipalityId], map: "idx_emergency_numbers_location")
  @@map("emergency_numbers")
}

model EmergencyContact {
  id                  String    @id @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  name                String    @db.VarChar(120)
  relationshipLabel   String?   @map("relationship_label") @db.VarChar(40)
  isPrimary           Boolean   @default(false) @map("is_primary")
  phoneCiphertext     Bytes?    @map("phone_ciphertext") @db.ByteA
  phoneNonce          Bytes?    @map("phone_nonce") @db.ByteA
  phoneTag            Bytes?    @map("phone_tag") @db.ByteA
  phoneEncryptedDek   Bytes?    @map("phone_encrypted_dek") @db.ByteA
  phoneKeyVersion     String?   @map("phone_key_version") @db.VarChar(100)
  phoneAadVersion     Int?      @default(2) @map("phone_aad_version")
  phoneHmac           Bytes?    @map("phone_hmac") @db.ByteA
  phoneHmacKeyVersion String?   @map("phone_hmac_key_version") @db.VarChar(100)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  syncVersion         BigInt    @default(0) @map("sync_version")
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([id, userId], map: "uq_emergency_contacts_id_user")
  @@index([userId], map: "idx_emergency_contacts_user_id")
  @@index([userId, syncVersion], map: "idx_emergency_contacts_user_sync_version")
  @@map("emergency_contacts")
}

model Vehicle {
  id                       String             @id @db.Uuid
  userId                   String             @map("user_id") @db.Uuid
  plateCiphertext          Bytes              @map("plate_ciphertext") @db.ByteA
  plateNonce               Bytes              @map("plate_nonce") @db.ByteA
  plateTag                 Bytes              @map("plate_tag") @db.ByteA
  plateEncryptedDek        Bytes              @map("plate_encrypted_dek") @db.ByteA
  plateKeyVersion          String             @map("plate_key_version") @db.VarChar(100)
  plateAadVersion          Int                @default(1) @map("plate_aad_version")
  plateHmac                Bytes              @map("plate_hmac") @db.ByteA
  plateHmacKeyVersion      String             @map("plate_hmac_key_version") @db.VarChar(100)
  brandId                  String?            @map("brand_id") @db.Uuid
  brandLabel               String             @map("brand_label") @db.VarChar(80)
  modelId                  String?            @map("model_id") @db.Uuid
  modelLabel               String             @map("model_label") @db.VarChar(100)
  modelYear                Int                @map("model_year") @db.SmallInt
  color                    String?            @db.VarChar(40)
  vehicleType              VehicleType        @map("vehicle_type")
  nickname                 String?            @db.VarChar(80)
  vinCiphertext            Bytes?             @map("vin_ciphertext") @db.ByteA
  vinNonce                 Bytes?             @map("vin_nonce") @db.ByteA
  vinTag                   Bytes?             @map("vin_tag") @db.ByteA
  vinEncryptedDek          Bytes?             @map("vin_encrypted_dek") @db.ByteA
  vinKeyVersion            String?            @map("vin_key_version") @db.VarChar(100)
  vinAadVersion            Int?               @map("vin_aad_version")
  vinHmac                  Bytes?             @map("vin_hmac") @db.ByteA
  vinHmacKeyVersion        String?            @map("vin_hmac_key_version") @db.VarChar(100)
  mileageKm                Int?               @map("mileage_km")
  photoStatus              VehiclePhotoStatus @default(none) @map("photo_status")
  photoObjectKey           String?            @map("photo_object_key") @db.VarChar(700)
  photoPendingObjectKey    String?            @map("photo_pending_object_key") @db.VarChar(700)
  photoPendingMimeType     String?            @map("photo_pending_mime_type") @db.VarChar(100)
  photoPendingSizeBytes    BigInt?            @map("photo_pending_size_bytes")
  photoMimeType            String?            @map("photo_mime_type") @db.VarChar(100)
  photoSizeBytes           BigInt?            @map("photo_size_bytes")
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?          @map("deleted_at") @db.Timestamptz(6)
  syncVersion              BigInt             @default(0) @map("sync_version")
  user                     User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  brand                    VehicleBrand?      @relation(fields: [brandId], references: [id], onDelete: Restrict)
  model                    VehicleModel?      @relation(fields: [modelId], references: [id], onDelete: Restrict)
  documents                VehicleDocument[]
  insurancePolicies        InsurancePolicy[]
  assistanceRequests       AssistanceRequest[]
  reviews                  Review[]

  @@unique([id, userId], map: "ux_vehicles_id_user")
  @@index([userId], map: "idx_vehicles_user_id")
  @@index([userId, syncVersion], map: "idx_vehicles_user_sync_version")
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_vehicles_user_created")
  @@index([brandId, modelId], map: "idx_vehicles_brand_model")
  @@map("vehicles")
}


enum VehicleDocumentType {
  poliza
  circulacion
  revision
  licencia
  otro

  @@map("vehicle_document_type")
}

enum DocumentFileStatus {
  pendiente_subida
  disponible

  @@map("document_file_status")
}

enum InsurancePolicyStatus {
  active
  archived

  @@map("insurance_policy_status")
}

model Insurer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(120)
  normalizedName String @unique(map: "ux_insurers_normalized_name") @map("normalized_name") @db.VarChar(120)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  policies    InsurancePolicy[]

  @@index([isActive, sortOrder, normalizedName], map: "idx_insurers_active_order")
  @@map("insurers")
}

model VehicleDocument {
  id                 String             @id @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  vehicleId          String             @map("vehicle_id") @db.Uuid
