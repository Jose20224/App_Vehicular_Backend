  targetStatus  String    @map("target_status") @db.VarChar(24)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  request       AssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, expiresAt], map: "idx_assistance_action_tokens_request_expiry")
  @@index([expiresAt], map: "idx_assistance_action_tokens_expiry")
  @@map("assistance_action_tokens")
}

model AssistanceRequestEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId     String   @map("request_id") @db.Uuid
  fromStatus    String?  @map("from_status") @db.VarChar(24)
  toStatus      String   @map("to_status") @db.VarChar(24)
  actorType     String   @map("actor_type") @db.VarChar(16)
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  request       AssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actorUser     User? @relation("AssistanceRequestEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt], map: "idx_assistance_request_events_request_created")
  @@map("assistance_request_events")
}

model WorkshopSpecialty {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  workshopId   String    @map("workshop_id") @db.Uuid
  specialtyId  String    @map("specialty_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  syncVersion  BigInt    @default(0) @map("sync_version")

  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  workshop   Workshop  @relation(fields: [workshopId, userId], references: [id, userId], onDelete: Restrict)
  specialty  Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([id, userId], map: "uq_workshop_specialties_id_user")
  @@index([userId, syncVersion], map: "idx_workshop_specialties_user_sync_version")
  @@index([specialtyId, workshopId], map: "idx_workshop_specialties_specialty_workshop")
  @@map("workshop_specialties")
}

model WorkshopPhoto {
  id           String             @id @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  workshopId   String             @map("workshop_id") @db.Uuid
  objectKey    String             @unique @map("object_key") @db.VarChar(700)
  altText      String?            @map("alt_text") @db.VarChar(160)
  mimeType     String             @map("mime_type") @db.VarChar(80)
  sizeBytes    BigInt             @map("size_bytes")
  sha256       Bytes?             @db.ByteA
  sortOrder    Int                @default(0) @map("sort_order") @db.SmallInt
  status       WorkshopPhotoStatus @default(pending)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz(6)
  syncVersion  BigInt             @default(0) @map("sync_version")

  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  workshop   Workshop  @relation(fields: [workshopId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([id, userId], map: "uq_workshop_photos_id_user")
  @@index([userId, syncVersion], map: "idx_workshop_photos_user_sync_version")
  @@index([workshopId, status, sortOrder], map: "idx_workshop_photos_workshop_visibility")
  @@map("workshop_photos")
}

model ServiceOffering {
  id                   String                @id @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  workshopId           String?               @map("workshop_id") @db.Uuid
  assistanceProviderId String?               @map("assistance_provider_id") @db.Uuid
  serviceTypeId        String                @map("service_type_id") @db.Uuid
  name                 String                @db.VarChar(120)
  description          String?               @db.VarChar(600)
  priceMin             Decimal               @map("price_min") @db.Decimal(12, 2)
  priceMax             Decimal               @map("price_max") @db.Decimal(12, 2)
  currency             String                @default("USD") @db.Char(3)
  unit                 String                @db.VarChar(80)
  notes                String?               @db.VarChar(600)
  lastUpdatedAt        DateTime              @default(now()) @map("last_updated_at") @db.Timestamptz(6)
  isActive             Boolean               @default(true) @map("is_active")
  publicationStatus    ServiceOfferingStatus @default(draft) @map("publication_status")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz(6)
  syncVersion          BigInt                @default(0) @map("sync_version")

  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  workshop           Workshop?          @relation("ServiceOfferingWorkshop", fields: [workshopId, userId], references: [id, userId], onDelete: Restrict)
  assistanceProvider AssistanceProvider? @relation("ServiceOfferingProvider", fields: [assistanceProviderId, userId], references: [id, userId], onDelete: Restrict)
  serviceType        ServiceType        @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)

  @@unique([id, userId], map: "uq_service_offerings_id_user")
  @@index([userId, syncVersion], map: "idx_service_offerings_user_sync_version")
  @@index([workshopId, publicationStatus], map: "idx_service_offerings_workshop_status")
  @@index([assistanceProviderId, publicationStatus], map: "idx_service_offerings_provider_status")
  @@index([serviceTypeId, publicationStatus], map: "idx_service_offerings_type_status")
  @@map("service_offerings")
}

model WorkshopContactEvent {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workshopId  String                    @map("workshop_id") @db.Uuid
  eventType   WorkshopContactEventType  @map("event_type")
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  workshop    Workshop                  @relation(fields: [workshopId], references: [id], onDelete: Restrict)

  @@index([workshopId, eventType, createdAt], map: "idx_workshop_contact_events_metrics")
  @@map("workshop_contact_events")
}

// B8: reseñas moderadas. El móvil no replica esta entidad en B5S; se opera online.
model Review {
  id                  String       @id @db.Uuid
  userId              String       @map("user_id") @db.Uuid
  workshopId          String       @map("workshop_id") @db.Uuid
  vehicleId           String?      @map("vehicle_id") @db.Uuid
  rating              Int          @db.SmallInt
  comment             String?      @db.VarChar(500)
  status              ReviewStatus @default(pending)
  contentFlagged      Boolean      @default(false) @map("content_flagged")
  moderationReason    String?      @map("moderation_reason") @db.VarChar(300)
  moderatedByUserId   String?      @map("moderated_by_user_id") @db.Uuid
  moderatedAt         DateTime?    @map("moderated_at") @db.Timestamptz(6)
  publishedAt         DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz(6)

  user       User       @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Restrict)
  workshop   Workshop   @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  vehicle    Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  moderator  User?      @relation("ReviewModerator", fields: [moderatedByUserId], references: [id], onDelete: Restrict)
  reply      ReviewReply?
  reports    ReviewReport[]

  @@index([workshopId, status, publishedAt(sort: Desc)], map: "idx_reviews_workshop_publication")
  @@index([userId, workshopId, createdAt(sort: Desc)], map: "idx_reviews_user_workshop_created")
  @@index([status, contentFlagged, createdAt], map: "idx_reviews_moderation_queue")
  @@map("reviews")
}

model ReviewReply {
  id          String   @id @db.Uuid
  reviewId    String   @unique(map: "uq_review_replies_review") @map("review_id") @db.Uuid
  workshopId  String   @map("workshop_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  replyText   String   @map("reply_text") @db.VarChar(1200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  review   Review   @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  workshop Workshop @relation(fields: [workshopId, userId], references: [id, userId], onDelete: Restrict)

  @@index([workshopId, createdAt(sort: Desc)], map: "idx_review_replies_workshop_created")
  @@map("review_replies")
}

model ReviewReport {
  id                String             @id @db.Uuid
  reviewId          String             @map("review_id") @db.Uuid
  reporterUserId    String             @map("reporter_user_id") @db.Uuid
  reporterRole      String             @map("reporter_role") @db.VarChar(16)
  reason            String             @db.VarChar(500)
  status            ReviewReportStatus @default(open)
  reviewedByUserId  String?            @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  review    Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  reporter  User   @relation("ReviewReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  moderator User?  @relation("ReviewReportModerator", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([status, createdAt], map: "idx_review_reports_status_created")
  @@index([reviewId, createdAt(sort: Desc)], map: "idx_review_reports_review_created")
  @@map("review_reports")
}
